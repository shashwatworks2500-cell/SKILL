# ─────────────────────────────────────────────────────────────
# Secrets — THIS REPOSITORY IS PUBLIC.
# Never commit credentials. Anything pushed here is permanently
# world-readable, even after deletion (git history + forks + caches).
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.env
secrets.*
credentials.*
.netrc
.npmrc
.pypirc

# Keys, certificates, tokens
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
*.der
*.asc
*.gpg
id_rsa*
id_ed25519*
*token*.json
*service-account*.json
*.credentials.json
gha-creds-*.json

# Cloud / provider CLI state
.aws/
.gcloud/
.azure/
.vercel/
.wrangler/
.supabase/
.terraform/
*.tfstate
*.tfstate.*
.terraformrc

# ─────────────────────────────────────────────────────────────
# Local Claude Code state (machine-specific; never shared)
# ─────────────────────────────────────────────────────────────
.claude/settings.local.json
.claude/*.local.json
.claude/history.jsonl
.claude/todos/
.claude/shell-snapshots/
.claude/statsig/
.mcp.local.json

# ─────────────────────────────────────────────────────────────
# Private working material (keep client work out of this repo)
# ─────────────────────────────────────────────────────────────
private/
scratch/
drafts/
client-*/
*.private.md

# ─────────────────────────────────────────────────────────────
# Dependencies & build output
# ─────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
.yarn/
bower_components/
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
.turbo/
.cache/
coverage/
.nyc_output/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Test & QA artifacts (visual QA baselines are committed deliberately;
# transient run output is not)
test-results/
playwright-report/
blob-report/
.playwright/
lighthouse-report.*
*.lighthouseci/
__diff_output__/
*.actual.png
*.diff.png

# ─────────────────────────────────────────────────────────────
# Logs & temporary files
# ─────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
*.bak
*.orig
*.swp
*.swo
tmp/

# ─────────────────────────────────────────────────────────────
# OS & editor cruft
# ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
.idea/
